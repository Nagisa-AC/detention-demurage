# Copy to terraform.tfvars. That file is gitignored.
# You apply this. The agent and CI do not.
# See README.md for the access key and the Vercel variables.

bucket_name   = "dd-recovery-us-east-2-change-me"
upload_origin = "https://detention-demurage.vercel.app"
# Hostname of the future customer portal. Passkeys are bound to it. Replace before apply.
portal_host   = "portal.example.com"
vpc_id      = "vpc-change-me"
subnet_id   = "subnet-change-me"
ami_id      = "ami-change-me"

# Current Amazon Linux 2023 arm64 AMI:
# aws ssm get-parameter --region us-east-2 --name /aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64 --query Parameter.Value --output text
#
# Create these two SecureStrings yourself. Terraform does not set them, so the values stay out of state:
# aws ssm put-parameter --region us-east-2 --name /dd/worker/database-url --type SecureString --value '...'
# aws ssm put-parameter --region us-east-2 --name /dd/worker/anthropic-api-key --type SecureString --value '...'
#
# The database URL must set sslmode=require, verify-ca, or verify-full.
#
# After apply, create the web user's access key (README.md), set the Vercel variables, copy the worker
# build to /opt/dd-worker/main.mjs as root mode 0644, then:
# sudo systemctl enable --now dd-worker
